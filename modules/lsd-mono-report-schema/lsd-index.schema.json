{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lsd-consulting.github.io/lsd-mono/schema/1.0.0/lsd-index.schema.json",
  "title": "IndexManifest",
  "description": "The index page's manifest of every report in an output directory: window.__LSD_INDEX__ in index.html. Each report's data loads from its <stem>-report.js when opened. Stable from 1.0.0: a minor version only adds, and a breaking change takes a new major version. Objects accept properties they do not list.",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "generatedAt",
    "generator",
    "options",
    "reports"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "The version of the schema the manifest follows; the same as the reports'. 1.0.0 for this schema."
    },
    "title": {
      "type": "string",
      "description": "Always `LSD reports` from lsd-mono-jvm."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the index was written: an RFC 3339 date-time, with Z or a UTC offset."
    },
    "generator": {
      "type": "string",
      "description": "As for a report; the usage ping matches it."
    },
    "options": {
      "title": "IndexOptions",
      "type": "object",
      "required": [
        "usagePing"
      ],
      "properties": {
        "usagePing": {
          "type": "boolean",
          "description": "As for a report."
        }
      }
    },
    "reports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/IndexReport"
      },
      "description": "Failed reports first, then warnings, then the rest; by title within each."
    }
  },
  "$defs": {
    "IndexCounts": {
      "title": "IndexCounts",
      "description": "A report's scenarios by outcome.",
      "type": "object",
      "required": [
        "success",
        "warn",
        "error"
      ],
      "properties": {
        "success": {
          "type": "integer",
          "minimum": 0
        },
        "warn": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "IndexScenario": {
      "title": "IndexScenario",
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "messages"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "status": {
          "$ref": "lsd-report.schema.json#/$defs/Status"
        },
        "messages": {
          "type": "integer",
          "minimum": 0,
          "description": "How many message events the scenario has."
        }
      }
    },
    "IndexReport": {
      "title": "IndexReport",
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "href",
        "counts",
        "scenarios"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The report's file-name stem, unique in the directory; its page's file name for an entry that is only a link."
        },
        "title": {
          "type": "string"
        },
        "status": {
          "$ref": "lsd-report.schema.json#/$defs/Status"
        },
        "href": {
          "type": "string",
          "description": "The report's own page (<stem>-diagram.html). Used when there is no data script."
        },
        "data": {
          "type": "string",
          "description": "<stem>-report.js. Absent for an entry that is only a link."
        },
        "counts": {
          "$ref": "#/$defs/IndexCounts"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IndexScenario"
          },
          "description": "In report order, so the index lists them before the data loads."
        }
      }
    }
  }
}
