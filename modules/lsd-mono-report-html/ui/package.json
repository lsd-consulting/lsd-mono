{
  "name": "lsd-report",
  "version": "0.1.0",
  "private": true,
  "description": "Living Sequence Diagrams HTML report UI, bundled by lsd-mono-report-html",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:static": "vite build",
    "build:single": "npm run build && node --experimental-strip-types scripts/inline-single.mjs",
    "test": "vitest run --coverage && node --experimental-strip-types scripts/coverage-ratchet.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "types:generate": "node scripts/report-types.mjs",
    "types:check": "node scripts/report-types.mjs --check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check:ux": "npm run build:single && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.64.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "gifenc": "1.0.3",
    "globals": "17.13.0",
    "happy-dom": "21.0.3",
    "json-schema-to-typescript": "16.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
