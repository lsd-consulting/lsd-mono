{
  "name": "lsd-mono-studio",
  "version": "0.0.0",
  "private": true,
  "description": "LSD Studio: import, keep, compare and watch LSD reports locally (early scaffold, #186)",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "lsd-mono-studio": "bin/lsd-mono-studio.js"
  },
  "files": [
    "bin/",
    "dist/",
    "public/",
    "viewer/lsd-report.html",
    "schema/lsd-report.schema.json",
    "README.md"
  ],
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "prepare": "node scripts/copy-schema.mjs && node scripts/build-viewer.mjs",
    "prepack": "node scripts/copy-schema.mjs && node scripts/build-viewer.mjs --required && npm run build",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:viewer": "node scripts/build-viewer.mjs --force",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
