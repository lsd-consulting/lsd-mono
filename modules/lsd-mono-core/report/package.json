{
  "name": "lsd-report",
  "version": "0.1.0",
  "private": true,
  "description": "Living Sequence Diagrams HTML report UI for lsd-mono-core",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:static": "vite build",
    "build:single": "npm run build && node --experimental-strip-types scripts/inline-single.mjs",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check:ux": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.55.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "gifenc": "^1.0.3",
    "globals": "17.13.0",
    "happy-dom": "^20.14.5",
    "pngjs": "^7.0.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
