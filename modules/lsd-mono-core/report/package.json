{
  "name": "lsd-report",
  "version": "0.1.0",
  "private": true,
  "description": "Living Sequence Diagrams HTML report UI for lsd-mono-core",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:static": "vite build",
    "build:single": "npm run build && node --experimental-strip-types scripts/inline-single.mjs",
    "test": "vitest run",
    "check:ux": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "gifenc": "^1.0.3",
    "happy-dom": "^20.14.5",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.0",
    "vite": "^7.1.7",
    "vitest": "^5.0.0"
  }
}
