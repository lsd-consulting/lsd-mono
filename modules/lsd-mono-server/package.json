{
  "name": "@lsd-consulting/lsd-server",
  "version": "0.0.0",
  "private": true,
  "description": "Local LSD server: import, keep, compare and watch LSD reports (early scaffold, #186)",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "public/",
    "viewer/lsd-report.html",
    "README.md"
  ],
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "prepare": "node scripts/build-viewer.mjs",
    "prepack": "node scripts/build-viewer.mjs --required",
    "build:viewer": "node scripts/build-viewer.mjs --force",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
